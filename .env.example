# ローカル開発用の環境変数テンプレート
# このファイルをコピーして .env.local を作成し、値を入力してください
# cp .env.example .env.local

# AWSリージョン
AWS_REGION=ap-northeast-1

# AWSアクセスキー（ローカル開発用）
# scripts/setup-aws.sh を実行すると自動生成されます
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDBテーブル名
TABLE_MASTER_USER=TABLE_MASTER_USER
TABLE_MASTER_TASK=TABLE_MASTER_TASK
TABLE_SUBMISSIONS=TABLE_SUBMISSIONS
TABLE_MASTER_REWARD=TABLE_MASTER_REWARD
TABLE_PUSH_SUBSCRIPTIONS=TABLE_PUSH_SUBSCRIPTIONS

# Web Push (VAPID)
# npx web-push generate-vapid-keys --json で生成してください
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ── Vercelデプロイ用（Vercelダッシュボードで設定） ──
# ローカル開発では不要です
#
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/family-point-app-vercel-oidc
